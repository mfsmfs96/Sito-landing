# ============================================================
# JARVIS V0 — configurazione (copia in .env e modifica)
# Tutti i default sono a COSTO ZERO e 100% locali.
# ============================================================

# --- Server ---
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8080

# --- LLM: ollama (locale, gratis) | groq (cloud, free tier) | openai_compat ---
JARVIS_LLM_PROVIDER=ollama
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
JARVIS_LLM_TEMPERATURE=0.6

# Usati solo se JARVIS_LLM_PROVIDER=groq  (https://console.groq.com/keys — free tier)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Usati solo se JARVIS_LLM_PROVIDER=openai_compat (qualsiasi endpoint OpenAI-compatible)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# --- STT: local (faster-whisper, offline) | groq (free tier) | browser ---
JARVIS_STT_PROVIDER=local
JARVIS_WHISPER_MODEL=base
JARVIS_WHISPER_COMPUTE=int8
JARVIS_LANG=it
GROQ_STT_MODEL=whisper-large-v3-turbo

# --- TTS: piper (offline) | browser (Web Speech API) | none ---
JARVIS_TTS_PROVIDER=piper
JARVIS_PIPER_VOICE=it_IT-paola-medium
JARVIS_PIPER_DATA_DIR=./voices

# --- Privacy ---
# L'audio non viene MAI salvato su disco. I trascritti restano in RAM.
# Metti true SOLO se vuoi un log locale delle conversazioni (mai l'audio).
JARVIS_SAVE_TRANSCRIPTS=false
JARVIS_TRANSCRIPT_DIR=./data/transcripts
